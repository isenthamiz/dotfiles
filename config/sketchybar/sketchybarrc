#!/usr/bin/env bash

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"

AEROSPACE_BIN="/opt/homebrew/bin/aerospace"
[[ -x "$AEROSPACE_BIN" ]] || AEROSPACE_BIN="/usr/local/bin/aerospace"

# --- Bar ---
sketchybar --bar height=37 color="$BAR_BG" border_width=0 padding_left=6 padding_right=6

# --- Defaults ---
sketchybar --default \
  icon.font="$FONT:Bold:16.0" \
  label.font="$FONT:Bold:12.0" \
  icon.color="$FG" \
  label.color="$FG" \
  padding_left=6 \
  padding_right=6 \
  background.drawing=off

# =============================================================
# LEFT: Apple (popped pill) + gap
# =============================================================
sketchybar --add item apple left
sketchybar --set apple \
  icon="$ICON_APPLE" \
  label.drawing=off \
  icon.font="$FONT:Bold:19.0" \
  PILL_BG=0xff6f647e \
  PILL_BG_ACTIVE=0xfff2c879 \
  ACCENT=0xff1a1b26 \   # dark text on gold
  icon.color="$ACCENT_2" \
  padding_left=12 \
  padding_right=12 \
  background.drawing=on \
  background.color="$PILL_BG" \
  background.corner_radius=12 \
  background.height=24 \
  click_script="open -a Finder"

sketchybar --add item apple_gap left
sketchybar --set apple_gap width=14 background.drawing=off icon="" label=""

# =============================================================
# LEFT: Workspaces as ID pills (created once)
# =============================================================
for sid in $("$AEROSPACE_BIN" list-workspaces --all); do
  sketchybar --add item "space.$sid" left
  sketchybar --set "space.$sid" \
    icon="" \
    label="$sid" \
    label.drawing=on \
    label.font="$FONT:Bold:14.0" \
    label.color="$FG" \
    background.drawing=off \
    click_script="$AEROSPACE_BIN workspace $sid"
done

# Gap after workspaces container
sketchybar --add item ws_gap left
sketchybar --set ws_gap width=10 background.drawing=off icon="" label=""

# Updater (invisible) refreshes workspaces
sketchybar --add item aerospace_ws_updater left
sketchybar --set aerospace_ws_updater \
  drawing=off \
  update_freq=1 \
  script="$PLUGIN_DIR/aerospace_ws_poll.sh"

sketchybar --add item ws_sep left
sketchybar --set ws_sep \
  icon="" \
  label=">" \
  label.font="$FONT:Bold:16.0" \
  label.color="$FG" \
  padding_left=6 \
  padding_right=10 \
  background.drawing=off

# Focused app name (left)
sketchybar --add item focused_app left
sketchybar --set focused_app \
  icon="" \
  label="…" \
  label.drawing=on \
  label.font="$FONT:Bold:14.0" \
  label.color="$FG" \
  padding_left=6 \
  padding_right=12 \
  update_freq=1 \
  script="$PLUGIN_DIR/focused_app_name_poll.sh"


# Focused app icon (left)
sketchybar --add item focused_app_icon left
sketchybar --set focused_app_icon \
  icon="$ICON_QUESTION" \
  label.drawing=off \
  icon.font="$FONT:Bold:20.0" \
  icon.color="$FG" \
  padding_left=6 \
  padding_right=10 \
  update_freq=1 \
  script="$PLUGIN_DIR/focused_app_poll.sh"

# =============================================================
# RIGHT: Wi-Fi, Battery, Date+Time (text)
# =============================================================
# =============================================================
# RIGHT: Status capsule (caps + items inside)
# =============================================================
sketchybar --add item status_cap_l right
sketchybar --set status_cap_l \
  icon="" label="" \
  width=6 \
  background.drawing=on \
  background.color="$PILL_BG" \
  background.corner_radius=12 \
  background.height=24

# Small gap inside the capsule at the start (optional)
sketchybar --add item status_inner_gap_l right
sketchybar --set status_inner_gap_l width=6 background.drawing=off icon="" label=""

sketchybar --add item datetime right
sketchybar --set datetime \
  icon="" \
  label.drawing=on \
  label.font="$FONT:Bold:12.0" \
  padding_left=10 \
  padding_right=10 \
  update_freq=10 \
  script="$PLUGIN_DIR/datetime.sh"

sketchybar --add item status_sep_1 right
sketchybar --set status_sep_1 \
  icon="" \
  label="|" \
  label.color="$FAINT" \
  label.font="$FONT:Bold:12.0" \
  padding_left=6 \
  padding_right=6 \
  background.drawing=off


sketchybar --add item battery right
sketchybar --set battery \
  icon="" \
  icon.padding_right=5 \
  label="" \
  lable.padding_left=2 \
  label.drawing=on \
  update_freq=30 \
  script="$PLUGIN_DIR/battery.sh"


sketchybar --add item status_sep_1 right
sketchybar --set status_sep_1 \
  icon="" \
  label="|" \
  label.color="$FAINT" \
  label.font="$FONT:Bold:12.0" \
  padding_left=6 \
  padding_right=6 \
  background.drawing=off


sketchybar --add item wifi right
sketchybar --set wifi \
  icon="" \
  icon.color="$FG" \
  label.drawing=on \
  label.color="$FG" \
  update_freq=10 \
  script="$PLUGIN_DIR/wifi.sh"

sketchybar --add item status_sep_1 right
sketchybar --set status_sep_1 \
  icon="" \
  label="|" \
  label.color="$FAINT" \
  label.font="$FONT:Bold:12.0" \
  padding_left=6 \
  padding_right=6 \
  background.drawing=off


sketchybar --add item volume right
sketchybar --set volume \
  icon="" \
  icon.padding_right=5 \
  label.padding_left=2 \
  label.drawing=on \
  label.color="$FG" \
  icon.color="$FG" \
  update_freq=2 \
  script="$PLUGIN_DIR/volume.sh"

# Separator before Now Playing (optional)
sketchybar --add item status_sep_np right
sketchybar --set status_sep_np \
  icon="" \
  label="|" \
  label.color="$FAINT" \
  label.font="$FONT:Bold:12.0" \
  padding_left=6 \
  padding_right=6 \
  background.drawing=off

# Now Playing (fixed width + marquee)
sketchybar --add item nowplaying right
sketchybar --set nowplaying \
  icon="" \
  icon.color="$FG" \
  icon.padding_right=8 \
  label.drawing=on \
  label.color="$FG" \
  label.max_chars=280 \
  label.font="Hack Nerd Font Mono:Bold:12.0" \
  width=280 \
  align=left \
  padding_left=8 \
  padding_right=8 \
  update_freq=1 \
  script="$PLUGIN_DIR/nowplaying_fade.sh"


# Small gap inside the capsule at the end (optional)
sketchybar --add item status_inner_gap_r right
sketchybar --set status_inner_gap_r width=6 background.drawing=off icon="" label=""

sketchybar --add item status_cap_r right
sketchybar --set status_cap_r \
  icon="" label="" \
  width=6 \
  background.drawing=on \
  background.color="$PILL_BG" \
  background.corner_radius=12 \
  background.height=24

# Outside gap after the capsule (optional)
sketchybar --add item status_gap right
sketchybar --set status_gap width=10 background.drawing=off icon="" label=""

sketchybar --update

